{
	"manifest_version": 3,
	"name": "Notate",
	"description": "Annotate specific elements on live pages. Keep what caught your attention, why it mattered, and the original context so you can return later.",
	"version": "1.18",
	"permissions": [
		"activeTab",
		"tabs",
		"windows",
		"storage",
		"scripting",
		"sidePanel"
	],
	"host_permissions": [
		"http://*/*",
		"https://*/*"
	],
	"background": {
		"service_worker": "scripts/background.js"
	},
	"action": {
		"default_title": "Notate",
		"default_icon": {
			"16": "images/icon-16.png",
			"32": "images/icon-32.png",
			"48": "images/icon-48.png",
			"128": "images/icon-128.png"
		}
	},
	"side_panel": {
		"default_path": "index.html"
	},
	"content_scripts": [
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"scripts/url-match.js",
				"scripts/safe-storage.js",
				"scripts/note-meta.js",
				"scripts/webpage.js"
			],
			"css": [
				"styles/webpage.css"
			]
		}
	],
	"icons": {
		"16": "images/icon-16.png",
		"32": "images/icon-32.png",
		"48": "images/icon-48.png",
		"128": "images/icon-128.png"
	}
}
